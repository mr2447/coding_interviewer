import json
from openai import OpenAI


client = OpenAI()

system_instructions = system_instructions = """
You are a Senior Technical Interview Coach. Your goal is to unblock the candidate and guide them to the solution without giving away the code.

**Your Constraints:**
1. **One-Way Comm:** The candidate sees your text but cannot reply. DO NOT ask direct questions expecting an answer.
2. **No Solutions:** NEVER output code blocks or rewrite their function.
3. **Brevity:** Keep hints under 3 sentences.

**Decision Logic (Prioritized):**

**Phase 0: Success Check (CRITICAL)**
Before hinting, check the code against the question description.
- If the code appears logically correct and handles the core requirements: **STOP.**
- Do NOT invent flaws. Output a confirmation (e.g., "Your logic looks solid. Try hitting 'Submit' to verify the test cases.").

**Phase 1: Analysis of Failure (If Test Results Exist)**
If tests failed, prioritize the specific error:
- **Compare Output:** Explicitly mention the discrepancy (e.g., "For input `[2, 3]`, we expected `5` but got `0`.").
- **Edge Cases:** If they failed on `[]` or `0`, hint at checking boundary conditions.

**Phase 2: Code Logic (If No Tests Run)**
- **Syntax:** If code won't compile, point out the specific syntax error.
- **Logic:** If code is valid but incomplete, identify the next missing logical step.

**Phase 3: Contextual & Progressive Hinting**
You have access to the full `conversation_history`. USE IT.
- **Build, Don't Repeat:** Do not blindly repeat previous hints. If you previously suggested "Check the loop," and they haven't fixed it, explain *why* the loop is wrong.
- **Chain Concepts:** Connect your new hint to previous ones (e.g., "Now that you've fixed the pointer increment, consider how you exit the loop.").
- **Progression:** Start subtle. If the history shows the user is stuck on the exact same error after 2 hints, get very specific.

**Tone:**
- Professional, encouraging, and observant.
"""

def create_input(desc_context, results_context, user_code):
    return f"""
    {desc_context}
    {results_context}
    Current Editor Code:
    {user_code}
    ---
    Based on the above, provide a hint to unblock me. Remember I cannot reply to you.
    """

def lambda_handler(event, context):
    """
    Entry point for LF2.
    Expected event: {
        "user_name": "Jesse",
        "qid": 105,
        "user_code": "...",
        "test_results_summary": {...},
        "question_dessciption: "...",
        "thread_id": "..." (Optional)
    """

    # Handle CORS preflight (OPTIONS) requests
    if event.get("httpMethod") == "OPTIONS":
        return {
            "statusCode": 200,
            "headers": {
                "Access-Control-Allow-Headers": "Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token",
                "Access-Control-Allow-Methods": "POST,OPTIONS",
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "http://localhost:5174",  # or * for dev
                "Access-Control-Allow-Credentials": "false"
            },
            "body": ""
        }

    body = event.get("body", {})

    body = json.loads(body) 
    user_code = body.get("user_code")
    test_results=body.get("test_results_summary", None)
    prev_id = body.get("thread_id", None)
    question_description = body.get("question_desc", None)

    if not user_code:
        return {
            "statusCode": 400,
                "headers": {
                    "Access-Control-Allow-Headers": "Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token",
                    "Access-Control-Allow-Methods": "POST,OPTIONS",
                    "Content-Type": "application/json",
                    "Access-Control-Allow-Origin": "http://localhost:5174",  # or * for dev
                    "Access-Control-Allow-Credentials": "false"
                },
            "body": json.dumps({
                "error": "Missing user code."
            })
        }
    #Construct the Context String

    desc_context = ""
    if not prev_id and question_description:
        desc_context = f"Question Description: {question_description}"

    results_context = "No execution history."
    if test_results:
        results_context = f"""
        Last Execution Result:
        Status: {test_results.get("status")}
        Failed Input: {test_results.get('first_failed_test', {}).get('input')}
        """

    input_context = create_input(desc_context, results_context, user_code)
    print(input_context)

    response_args = {
        "model": "gpt-4o-mini",
        "instructions": system_instructions,
        "input": input_context,
    }
    print("PREV ID", prev_id)
    if prev_id:
        response_args["previous_response_id"] = prev_id
    else:
        response_args["store"] = True

    try:
        response = client.responses.create(**response_args)
        hint = response.output_text
        
        if not prev_id:
            thread_id = response.id
        else:
            thread_id = prev_id

        print("THREAD ID", thread_id)
        
        return {
            "statusCode": 200,
            "headers": {
                "Access-Control-Allow-Headers": "Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token",
                "Access-Control-Allow-Methods": "POST,OPTIONS",
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "http://localhost:5174",  # or * for dev
                "Access-Control-Allow-Credentials": "false"
            },
            "body": json.dumps({
                "hint": hint,
                "thread_id": thread_id,
            })
        }
    except Exception as e:
        print(f"Error calling OpenAI: {str(e)}")
        return {
            "statusCode": 500,
            "headers": {
                "Access-Control-Allow-Headers": "Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token",
                "Access-Control-Allow-Methods": "POST,OPTIONS",
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "http://localhost:5174",  # or * for dev
                "Access-Control-Allow-Credentials": "false"
            },
            "body": json.dumps({
                "error": f"Failed to generate hint: {str(e)}"
            })
        }

